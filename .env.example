# ============================================================
# Excel Agent 后端环境变量参考
# 复制为 .env 并填写必填项后启动服务
# 不要把 .env 提交到 git（已在 .gitignore 中排除）
# ============================================================

# ===== AI 配置（必填）=====
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://noingfushanquan.online/v1/chat/completions
AI_MODEL=MiniMax-M2.7
# AI 请求超时秒数，建议 60-120
AI_TIMEOUT=60

# ===== COS 配置（留空则自动启用本地模式）=====
# 本地开发时可以留空，结果文件直接从后端下载
# 生产环境建议配置 COS 持久化结果文件
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=yanghao-1303848059
COS_REGION=ap-guangzhou
COS_BASE_URL=https://yanghao-1303848059.cos.ap-guangzhou.myqcloud.com

# ===== 文件存储路径（绝对路径）=====
# Docker 环境：与 docker-compose.yml 中的 volume 保持一致
# 本地开发：默认 /tmp/uploads 和 /tmp/results
UPLOAD_DIR=/tmp/uploads
RESULT_DIR=/tmp/results

# ===== 文件大小限制 =====
# 单位 MB，需与 Nginx client_max_body_size 保持一致
MAX_UPLOAD_MB=50

# ===== 应用版本信息（CI/CD 构建时注入）=====
# 手动部署时可以手填，用于 /api/health 返回
APP_VERSION=0.1.0
# git rev-parse --short HEAD 的输出
GIT_COMMIT=unknown
